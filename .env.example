APP_SERVICE_NAME=modular-monolith-api
APP_ENVIRONMENT=local
APP_DOCS_ENABLED=true
APP_LOG_LEVEL=INFO
APP_LOG_JSON=false
APP_SERVER_HOST=127.0.0.1
APP_SERVER_PORT=8000

APP_DATABASE_URL=postgresql+asyncpg://app:change-me-local-only@localhost:5432/app
APP_DATABASE_ECHO=false
APP_DATABASE_POOL_SIZE=10
APP_DATABASE_MAX_OVERFLOW=20
APP_DATABASE_POOL_RECYCLE_SECONDS=1800

APP_TRUSTED_HOSTS=["localhost","127.0.0.1","testserver"]
APP_CORS_ORIGINS=[]

POSTGRES_DB=galaxy_universal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1234
APP_PORT=8000